# Copy to docker/.env.classroom and replace this before first startup (12+ characters).
LAYERLING_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# HTTPS reverse proxy (Caddy/nginx) on the same Ubuntu host:
LAYERLING_BIND_ADDRESS=127.0.0.1
LAYERLING_PORT=4006
LAYERLING_COOKIE_SECURE=true
# Public browser origin, e.g. https://cad.school.example
LAYERLING_ALLOWED_ORIGINS=
LAYERLING_SOURCE_CODE_URL=https://github.com/rrmm94/layerling
