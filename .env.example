# Copy to .env (or use scripts/configure-dockge.py) and set a private password before first use.
LAYERLING_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# Direct access in the trusted LAN: http://SERVER-IP:4006
LAYERLING_BIND_ADDRESS=0.0.0.0
LAYERLING_PORT=4006
LAYERLING_COOKIE_SECURE=false
# For an HTTPS reverse proxy on the host instead:
# LAYERLING_BIND_ADDRESS=127.0.0.1
# LAYERLING_COOKIE_SECURE=true
# LAYERLING_ALLOWED_ORIGINS=https://cad.school.example
LAYERLING_ALLOWED_ORIGINS=
LAYERLING_SOURCE_CODE_URL=https://github.com/rrmm94/layerling
# Existing deployments retain this named volume; never change it to fix an empty dashboard.
LAYERLING_DATA_VOLUME=layerling_classroom-data
